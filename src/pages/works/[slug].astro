---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { works } from '../../data/site.js';

export function getStaticPaths() {
  return works.map((w) => ({ params: { slug: w.slug }, props: { work: w } }));
}

const { work: w } = Astro.props;
const idx = works.findIndex((x) => x.slug === w.slug);
const next = works[(idx + 1) % works.length];
---

<Base title={`NORD — ${w.title}`}>
  <Nav current="works" />

  <section class="cs-hero">
    <a href="/#works" class="back">← ALL WORK</a>
    <div class="h2">{w.num} // {w.category}</div>
    <h1 class="cs-title">
      <span class="glitch" data-t={w.title}>{w.title}</span>
    </h1>
    <div class="cs-meta">
      <div><div class="k">Client</div><div class="v">{w.client}</div></div>
      <div><div class="k">Year</div><div class="v">{w.year}</div></div>
      <div><div class="k">Role</div><div class="v">{w.role}</div></div>
      <div><div class="k">Scope</div><div class="v">{w.scope.join(' · ')}</div></div>
    </div>
  </section>

  <div class="crack" id="crack2">⚠ THE OPPOSITE IS UNDERNEATH — {w.reveal}</div>

  {w.cover && (
    <div class="cs-cover">
      <img src={w.cover} alt={`${w.title} cover`} loading="lazy" />
    </div>
  )}

  <section class="cs-body">
    <div class="cs-block">
      <div class="h2">Hypothesis</div>
      <p class="lead glitch" data-t={w.hypothesis}>{w.hypothesis}</p>
    </div>
    <div class="cs-block">
      <div class="h2">Visual Logic</div>
      <p>{w.visualLogic}</p>
    </div>
    <div class="cs-block">
      <div class="h2">Synthesis</div>
      <p class="synth">{w.synthesis}</p>
    </div>

    <div class="cs-block">
      <div class="h2">The Challenge</div>
      <p>{w.challenge}</p>
    </div>
    <div class="cs-block">
      <div class="h2">The Approach</div>
      <p>{w.approach}</p>
    </div>

    <div class="cs-block">
      <div class="h2">Deliverables</div>
      <ul class="dlist">
        {w.deliverables.map((d) => <li>{d}</li>)}
      </ul>
    </div>
    <div class="cs-block">
      <div class="h2">Outcome</div>
      <p>{w.outcome}</p>
    </div>
  </section>

  {w.gallery && w.gallery.length > 0 && (
    <section class="cs-gallery">
      <div class="h2">Gallery</div>
      <div class="g-grid">
        {w.gallery.map((g) => (
          <img src={g} alt={`${w.title} work`} loading="lazy" />
        ))}
      </div>
    </section>
  )}

  <section class="cs-next">
    <a href={`/works/${next.slug}`} class="next-link">
      <div class="h2">Next project</div>
      <div class="next-title glitch" data-t={next.title}>{next.title} →</div>
    </a>
  </section>

  <div class="hint">hover the type · scroll for the crack</div>
</Base>

<style>
  .cs-hero { padding: 140px 48px 60px; }
  .back { font-family: var(--mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .back:hover { color: var(--ink); }
  .cs-title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(48px, 9vw, 140px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 18px 0 40px;
  }
  .cs-meta { display: flex; flex-wrap: wrap; gap: 48px; border-top: 1px solid var(--rule); padding-top: 28px; }
  .cs-meta .k { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dimmer); margin-bottom: 6px; }
  .cs-meta .v { font-family: var(--serif); font-size: 18px; font-weight: 500; }

  .cs-cover { padding: 0 48px 60px; }
  .cs-cover img { width: 100%; height: auto; border: 1px solid var(--rule); display: block; }

  .cs-body { display: grid; grid-template-columns: 1fr 1fr; gap: 64px 72px; padding: 90px 48px; }
  .cs-block:nth-child(1), .cs-block:nth-child(2), .cs-block:nth-child(3) { grid-column: span 1; }
  .cs-block p { font-size: 17px; line-height: 1.85; color: rgba(22,21,15,0.72); }
  .cs-block .lead { font-family: var(--serif); font-weight: 300; font-size: clamp(22px, 2.6vw, 30px); line-height: 1.3; color: var(--ink); }
  .cs-block .synth { font-family: var(--serif); font-style: italic; font-size: 22px; color: var(--ink); }
  .dlist { list-style: none; }
  .dlist li { font-size: 16px; line-height: 1.9; color: rgba(22,21,15,0.72); border-bottom: 1px solid var(--rule); padding: 10px 0; }

  .cs-gallery { padding: 40px 48px 90px; }
  .g-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 24px; }
  .g-grid img { width: 100%; height: auto; border: 1px solid var(--rule); }

  .cs-next { border-top: 2px solid var(--ink); text-align: center; padding: 100px 48px; }
  .next-title { font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 7vw, 90px); letter-spacing: -0.02em; margin-top: 8px; }

  @media (max-width: 720px) {
    .cs-hero, .cs-cover, .cs-body, .cs-gallery, .cs-next { padding-left: 20px; padding-right: 20px; }
    .cs-body { grid-template-columns: 1fr; gap: 32px; }
    .g-grid { grid-template-columns: 1fr; }
  }
</style>
