---
// Contact footer (home)
import { contact } from '../data/site.js';
---

<footer id="contact" style="position:relative; border-top:2px solid #C6FF00;">
  <div style="padding:clamp(70px,10vw,110px) clamp(16px,4vw,48px) 60px; text-align:center;">
    <div style="font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(244,244,242,0.3); margin-bottom:26px;">Signal received? Let's transmit.</div>
    <a href={`mailto:${contact.email}`} data-cta style="text-decoration:none; color:#F4F4F2; display:block;">
      <div style="font-size:clamp(40px,9vw,150px); font-weight:800; letter-spacing:-0.045em; line-height:0.86; text-transform:uppercase;">Ready to<br />experiment<span style="color:#C6FF00;">?</span></div>
    </a>
    <a href={`mailto:${contact.email}`} data-cta style="display:inline-block; margin-top:44px; background:#C6FF00; color:#0E0E0E; font-family:'Space Mono',monospace; font-size:12px; letter-spacing:0.14em; text-transform:uppercase; text-decoration:none; padding:18px 44px; font-weight:700;">Let's build something inevitable →</a>
    <div style="margin-top:34px; display:flex; gap:18px; justify-content:center; flex-wrap:wrap; font-family:'Space Mono',monospace; font-size:11px; color:rgba(244,244,242,0.45); letter-spacing:0.08em;">
      <a href={`tel:${contact.phone.replace(/\s|\(|\)/g, '')}`} style="color:inherit; text-decoration:none;">{contact.phone}</a>
      <span style="color:#C6FF00;">/</span>
      <a href={`mailto:${contact.emailAlt}`} style="color:inherit; text-decoration:none;">{contact.emailAlt}</a>
      <span style="color:#C6FF00;">/</span>
      <span>{contact.social}</span>
    </div>
  </div>
  <div style="display:flex; justify-content:space-between; align-items:center; padding:22px clamp(16px,3vw,48px); border-top:1px solid #242424; font-family:'Space Mono',monospace; font-size:10px; color:rgba(244,244,242,0.3); letter-spacing:0.1em; text-transform:uppercase; flex-wrap:wrap; gap:8px;">
    <span>© 2026 Panpong Varavarn</span>
    <span>Structured Chaos™ // Creativity Lab</span>
    <span>Node: Bangkok, TH</span>
  </div>
</footer>
