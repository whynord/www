---
import { stack } from "../data/site.js";
---

<section
    id="lab"
    style="display:grid; grid-template-columns:1fr 1fr; border-bottom:1px solid #242424;"
>
    <div
        data-reveal
        style="padding:clamp(48px,6vw,80px) clamp(16px,3vw,48px); border-right:1px solid #242424; display:flex; flex-direction:column; justify-content:center;"
    >
        <div
            style="font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:#C6FF00; margin-bottom:24px;"
        >
            The Lab // Tech Stack
        </div>
        <h2
            style="font-size:clamp(28px,3.4vw,46px); line-height:1.05; letter-spacing:-0.03em; font-weight:800; margin:0 0 24px;"
        >
            Creativity runs on boredom
        </h2>
        <p
            style="font-family:'Space Mono',monospace; font-size:14px; line-height:1.2; color:rgba(244,244,242,0.45); margin:0 0 14px;"
        >
            Design is creative reaction to problems and boredom. Design without
            implementation is decoration. I build what I conceive — from brand
            identity through to the web experience that carries it.
        </p>
        <p
            style="font-family:'Space Mono',monospace; font-size:14px; line-height:1.2; color:rgba(244,244,242,0.45); margin:0;"
        >
            The field to the right is live — rendered in real time on a Canvas.
            A small proof that aesthetics and engineering aren't opposites.
        </p>

        <div style="margin-top:34px;">
            {
                stack.map((t) => (
                    <div style="display:flex; align-items:center; gap:16px; padding:14px 0; border-top:1px solid #242424; font-size:12px;">
                        <div style="width:6px; height:6px; background:#C6FF00; border-radius:50%; flex-shrink:0;" />
                        <div style="flex:1; font-weight:700;">{t.name}</div>
                        <div style="font-family:'Space Mono',monospace; font-size:10px; color:#8a8a8a; letter-spacing:0.06em;">
                            {t.use}
                        </div>
                        <div style="width:80px; height:2px; background:rgba(244,244,242,0.1);">
                            <div
                                data-bar={t.w}
                                style="height:100%; width:0; background:#C6FF00; transition:width 1.2s ease;"
                            />
                        </div>
                    </div>
                ))
            }
            <div style="border-top:1px solid #242424;"></div>
        </div>
    </div>

    <div
        style="padding:32px; display:flex; align-items:center; justify-content:center; background:#080808; min-height:480px;"
    >
        <canvas
            id="nordparticles"
            style="width:100%; height:400px; display:block;"></canvas>
    </div>
</section>
