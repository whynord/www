---
import NordLogo from "../images/NORD-Logo-2026-Secondary-LasPalmas.png";
---

<div class="flex sticky w-full h-20 min-h-20 bg-brightemerald/70 backdrop-blur-xs top-0 m-0 py-3 place-self-center justify-center z-99 bg-prune">
    <div id="motherOfMenu" class="flex relative w-full h-full max-w-400 min-w-87.5">
        <div class="flex w-full h-full flex-col items-between justify-end tablet:flex-row tablet:justify-between tablet:items-end tablet:h-20">
            <div class="flex absolute left-10 top-5 h-fit w-fit">
                <a href="/">
                    <img src={NordLogo.src} alt="NORD Logo" class="h-8 min-h-8" />
                </a>
            </div>
            <div class="flex absolute right-10 top-10 w-fit justify-end">
                <div id="menu-normal" class="hidden invisible justify-end h-fit w-fit gap-15 place-items-baseline tablet:flex tablet:visible text-[0.6rem]">
                    <div><a href="/">Home</a></div>
                    <div><a href="/about">About</a></div>
                    <div><a href="/works">Works</a></div>
                    <div><a href="/contact">Contact</a></div>
                </div>
            </div>
            <div class="flex absolute right-10 top-5 w-full tablet:invisible justify-end">
                <input type="checkbox" id="menu-toggle" class="hidden invisible w-0 h-0">
                <label for="menu-toggle" id="menu-icon" class="w-fit h-fit absolute top-0 right-0 flex tablet:invisible tablet:w-0 tablet:hidden font-googlemdi text-2xl text-laspalmas cursor-pointer">
                    menu
                </label>
                <label for="menu-toggle" id="menu-close" class="absolute top-0 right-0 hidden invisible w-0 font-googlemdi text-2xl text-laspalmas cursor-pointer">
                    close
                </label>
                <div id="menu-mobile" class="tablet:hidden w-full h-fit hidden tablet:invisible invisible tablet:w-0 tablet:h-0 absolute top-10 left-8 font-sora gap-3 bg-prune shadow-2xl">
                    <div class="border-b-1 border-dotted border-laspalmas"><a href="/"><span class="font-googlemdi mr-5">home</span> Home</a></div>
                    <div class="border-b-1 border-dotted border-laspalmas"><a href="/about"><span class="font-googlemdi mr-5">article_person</span> About</a></div>
                    <div class="border-b-1 border-dotted border-laspalmas"><a href="/works"><span class="font-googlemdi mr-5">work</span> Works</a></div>
                    <div class="border-b-1 border-dotted border-laspalmas"><a href="/contact"><span class="font-googlemdi mr-5">contact_phone</span> Contact</a></div>
                </div>
                { /*
                <div id="nordMenu" class="hidden invisible tablet:hidden tablet:invisible">


                    <input type="checkbox" id="menu-toggle">
                    <label for="menu-toggle" id="menu-icon" class="w-fit h-fit absolute top-0 right-0 flex tablet:invisible tablet:w-0 tablet:hidden font-googlemdi text-2xl text-sherpasblue cursor-pointer">
                        menu
                    </label>
                    <label for="menu-toggle" id="menu-close" class="absolute top-0 right-0 hidden invisible w-0 font-googlemdi text-2xl text-laspalmas cursor-pointer">
                        close
                    </label>
                </div>
                */ }
            </div>
        </div>
    </div>
</div>

<style scoped>
    #menu-normal,
    #menu-normal a,
    #menu-normal a:link,
    #menu-normal a:visited,
    #menu-normal a:active  {
        font-family: "Funnel Display", sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05rem;
        display: flex;
        flex-direction: row;
        text-transform: uppercase;
        color: var(--color-laspalmas);
    }

    #menu-normal a:hover {
        color: var(--color-crispypink);
    }

    #menu-mobile,
    #menu-mobile a,
    #menu-mobile a:link,
    #menu-mobile a:visited,
    #menu-mobile a:active  {
        color: var(--color-laspalmas);
    }

    #menu-mobile a:hover {
        color: var(--color-crispypink);
    }

    /*
    .navi div {
        font-family: "sora", sans-serif;
        font-weight: 500;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        height: fit-content;
        display: flex;
        align-self: safe flex-start;
    }
    .navi a,
    .navi a:link,
    .navi a:visted {
        text-decoration: none;
        color: var(--color-laspalmas);
    }
    .navi a:hover {
        text-decoration: none;
        color:var(--color-brightemerald);
    }

    */

    .material-symbols-outlined {
        font-family: "Material Symbols Outlined";
        font-weight: normal;
        font-style: normal;
        font-size: 24px; /* Preferred icon size */
        display: inline-block;
        line-height: 1;
        text-transform: none;
        letter-spacing: normal;
        word-wrap: normal;
        white-space: nowrap;
        direction: ltr;
    }

    #nordMenu {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: 0px;
        right: 0px;
        width: 100vw;
        height: 100vh;
    }

    #menu-toggle {
        visibility:  hidden;
        display: none;


    }

    #menuToggle:checked ~ #menu-mobile
    {
        backdrop-filter: blur(var(--blur-sm));
    }

    #menu-mobile {
        /*
        color: var(--color-brightemerald);
        font-family: "Funnel Display", sans-serif;
        font-size: 2.2rem;
        font-weight: 400;
        letter-spacing: 0.1rem;
        display: flex;
        position: absolute;
        flex-direction: column;
        text-transform: uppercase;
        width: 100vw;
        height: 100vh;
        margin: -100% 0 0 -50px;


        backdrop-filter: blur(var(--blur-sm));
        transform-origin: 0% 0%;
        transform: translate(-100%, 0);

        transition: transform 0.5s cubic-bezier(0.77,0.2,0.05,1.0);
        */


        opacity: 1;
        font-size: 1.7em;
        color: var(--color-sherpasblue);
        display: flex;
        flex-direction: column;
        position: relative;

        padding: 20px 100px 50px 50px;
        box-sizing: border-box;
        width: 100vw;
        overflow-y: auto;



        -webkit-font-smoothing: antialiased;
        /* to stop flickering of text in safari */


    }

    #menu-toggle:checked ~ #menu-mobile { display: flex; visibility: visible; width: 100vw; height: fit-content;}
    #menu-toggle:checked ~ #nordMenu { display:flex; visibility: visible; width: 100vw; height: fit-content;}

    #menu-toggle:checked ~ #menu-close { display: flex; visibility: visible; width: fit-content; height: fit-content; }
    #menu-toggle:checked ~ #menu-icon  { display: none; visibility: hidden; width: 0; height: 0;}

    /* Show the menu when the hidden checkbox is checked */
    /*
    #menu-toggle:checked ~ #menu-mobile { top: 0px; left: 0px; display: block;}
    #menu-toggle:checked ~ #menu-normal { display: none; visibility: invisible; width: 0; height: 0; }
    #menu-toggle:checked ~ #menu-close { display: flex; visibility: visible; width: fit-content; height: fit-content; }
    #menu-toggle:checked ~ #menu-icon  { display: none; visibility: hidden; width: 0; height: 0;}

    #menu-toggle:unchecked ~ #menu-mobile { display: none; visibility: invisible; width: 0; height: 0; }
    #menu-toggle:unchecked ~ #menu-normal { display: flex; visibility: visible; width: fit-content; height: fit-content; }
    #menu-toggle:unchecked ~ #menu-close { display: none; visibility: invisible; width: 0; height: 0; }
    #menu-toggle:unchecked ~ #menu-icon { display: flex; visibility: visible; width: fit-content; height: fit-content; }
*/

</style>
