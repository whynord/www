---
interface Props {
  current?: 'home' | 'works' | 'about';
}
const { current = 'home' } = Astro.props;
---

<nav>
  <a href="/" class="brand">Nord</a>
  <div class="links">
    <a href="/#about" class={current === 'about' ? 'active' : ''}>About</a>
    <a href="/#works" class={current === 'works' ? 'active' : ''}>Work</a>
    <a href="/#offerings">Offerings</a>
    <a href="/#contact">Contact</a>
  </div>
</nav>
