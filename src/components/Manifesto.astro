---
import { skills, identity } from '../data/site.js';
---

<section id="manifesto" style="display:grid; grid-template-columns:1fr 2fr; border-bottom:1px solid #242424;">
  <div data-reveal style="padding:clamp(48px,8vw,96px) clamp(16px,3vw,48px); border-right:1px solid #242424; display:flex; flex-direction:column; justify-content:space-between; gap:40px;">
    <div>
      <div style="font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:#C6FF00; margin-bottom:20px;">The mind behind the lab</div>
      <h2 style="font-size:clamp(26px,3.6vw,46px); line-height:1.06; letter-spacing:-0.03em; font-weight:800; margin:0;">Twenty-five years dismantling visual systems to see how they really work.</h2>
    </div>
    <div>
      <div style="font-size:15px; font-weight:700; margin-bottom:4px;">{identity.name} <span style="color:#8a8a8a; font-weight:400;">“{identity.alias}”</span></div>
      <div style="font-family:'Space Mono',monospace; font-size:11px; color:#C6FF00; letter-spacing:0.06em;">{identity.role}</div>
    </div>
  </div>

  <div data-reveal style="padding:clamp(48px,8vw,96px) clamp(16px,4vw,64px);">
    <p style="font-size:clamp(15px,1.5vw,17px); line-height:1.85; color:rgba(244,244,242,0.6); margin:0 0 26px;">{identity.intro} {identity.introSub}</p>
    <p style="font-size:clamp(15px,1.5vw,17px); line-height:1.85; color:rgba(244,244,242,0.6); margin:0 0 26px;">I don't "design logos." I build <strong style="color:#F4F4F2; font-weight:700;">visual frequencies</strong>. From the sterile precision of medical luxury to the disruptive noise of urban chaos, my work lives in the tension between the grid and the glitch.</p>
    <p style="font-size:clamp(15px,1.5vw,17px); line-height:1.85; color:rgba(244,244,242,0.6); margin:0;">A brand is not a mark — it's an <strong style="color:#F4F4F2; font-weight:700;">atmosphere</strong>. My job is to find the exact frequency where a brand stops being a business and starts becoming <strong style="color:#F4F4F2; font-weight:700;">inevitable</strong>. And across 25 years, B2B and B2C, local and international, I've built, grown and transformed brands from conception through strategy to execution. I'm also, genuinely, fun to work with.</p>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:#242424; margin-top:46px; border-top:1px solid #242424;">
      {skills.map((sk) => (
        <div data-skill style="background:#0E0E0E; padding:24px 26px; transition:background .25s ease;">
          <div style="font-family:'Space Mono',monospace; font-size:10px; color:#C6FF00; letter-spacing:0.1em; margin-bottom:10px;">{sk.num}</div>
          <div style="font-size:14px; font-weight:700; margin-bottom:8px;">{sk.name}</div>
          <div style="font-family:'Space Mono',monospace; font-size:10px; color:#8a8a8a; line-height:1.8;">{sk.tags}</div>
        </div>
      ))}
    </div>
  </div>
</section>
