---
import { experiments } from '../data/site.js';
---

<div id="experiments" style="display:flex; justify-content:space-between; align-items:center; padding:30px clamp(16px,3vw,48px); border-bottom:1px solid #242424;">
  <h2 style="font-family:'Space Mono',monospace; font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(244,244,242,0.4); margin:0;">Experiments // Selected Work</h2>
  <span style="font-family:'Space Mono',monospace; font-size:10px; color:rgba(244,244,242,0.25); letter-spacing:0.1em;">SCROLL TO OBSERVE ↓</span>
</div>

{experiments.map((x) => (
  <div data-reveal style="display:grid; grid-template-columns:1fr 1.8fr; min-height:74vh; border-bottom:1px solid #242424;">
    <div style="padding:clamp(40px,5vw,64px) clamp(16px,3vw,48px); border-right:1px solid #242424; display:flex; flex-direction:column; justify-content:center;">
      <div style="font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:#C6FF00; margin-bottom:16px;">{x.freq}</div>
      <div style={`font-size:clamp(40px,5.4vw,82px); line-height:0.92; letter-spacing:-0.03em; font-weight:800; text-transform:uppercase; margin-bottom:38px;${x.glitch ? ' animation:nd-glitch 3.5s infinite;' : ''}`}>{x.title}</div>
      <div style="display:flex; flex-direction:column; gap:20px;">
        <div>
          <div style="font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8a8a; margin-bottom:5px;">Hypothesis</div>
          <div style="font-size:13px; line-height:1.7; color:rgba(244,244,242,0.65);">{x.hypothesis}</div>
        </div>
        <div>
          <div style="font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8a8a; margin-bottom:5px;">Visual Logic</div>
          <div style="font-size:13px; line-height:1.7; color:rgba(244,244,242,0.65);"><strong style="color:#F4F4F2;">{x.logicLead}</strong> {x.logic}</div>
        </div>
        <div>
          <div style="font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:#8a8a8a; margin-bottom:5px;">Synthesis</div>
          <div style="font-size:13px; line-height:1.7; color:rgba(244,244,242,0.65);">{x.synthesis}</div>
        </div>
      </div>
    </div>

    {x.light ? (
      <div style="padding:clamp(32px,4vw,56px); display:flex; align-items:center; justify-content:center; position:relative; background:#EBEBEB;">
        {x.img ? (
          <img src={x.img} alt={x.title} style="width:100%; max-width:640px; aspect-ratio:4/3; object-fit:cover; border:1px solid #0E0E0E; display:block;" />
        ) : (
          <div style="width:100%; max-width:640px; aspect-ratio:4/3; border:1px solid #0E0E0E; background-image:repeating-linear-gradient(45deg,rgba(14,14,14,0.45) 0 1px,transparent 1px 12px); display:flex; align-items:flex-end; padding:16px;">
            <span style="font-family:'Space Mono',monospace; font-size:11px; background:#0E0E0E; color:#C6FF00; padding:5px 9px;">{x.imglabel}</span>
          </div>
        )}
      </div>
    ) : (
      <div style="padding:clamp(32px,4vw,56px); display:flex; align-items:center; justify-content:center; position:relative; background:#0c0c0c;">
        {x.img ? (
          <img src={x.img} alt={x.title} style="width:100%; max-width:640px; aspect-ratio:4/3; object-fit:cover; border:1px solid #242424; display:block;" />
        ) : (
          <div style="width:100%; max-width:640px; aspect-ratio:4/3; border:1px solid #242424; background-image:repeating-linear-gradient(45deg,rgba(244,244,242,0.5) 0 1px,transparent 1px 12px); display:flex; align-items:flex-end; padding:16px;">
            <span style="font-family:'Space Mono',monospace; font-size:11px; background:#C6FF00; color:#0E0E0E; padding:5px 9px;">{x.imglabel}</span>
          </div>
        )}
      </div>
    )}
  </div>
))}
