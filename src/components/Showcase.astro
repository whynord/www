   }

   .tn .item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
   }
   

   .tn .item .content {
    position: absolute;
    inset: auto 10px 10px 10px;
    color: var(--color-pastellime);
    opacity: 0;
   }


    @media screen and (max-width: 800px) {

