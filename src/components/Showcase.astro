    }

    .slider .list .item::after {
        content: "";
        width: 100%;
        height: 100%;
        position: absolute;
        left: 0;
        bottom: 0;
        z-index: 1;
        background: linear-gradient(0deg,rgba(26, 26, 50, 1) 5%, rgba(26, 26, 50, 0) 70%);
    }

    .slider .list .item.active .content-wrapper {

    }

    .slider .list .item .content-wrapper .content,
    .slider .list .item.active .content-wrapper .content {
        position: absolute;
        bottom:200px;
        right: 10%;
        width: 50%;
        height: fit-content;
        max-width: 450px;
        min-width: 350px;
        place-self: center;
        z-index: 2;
    }

    .slider .list .item .content-wrapper .content div {
        text-transform: uppercase;
        letter-spacing: 0.45rem;
        padding-bottom: 55px;
        color: var(--color-nordsilver-300);
    }

    .slider .list .item .content-wrapper .content p {
