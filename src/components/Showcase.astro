<script>

    let items = document.querySelectorAll('.slider .list .item');
    let next = document.getElementById('next');
    let prev = document.getElementById('prev');
    let thumb = document.querySelectorAll('.tn .item');

    let countItem = items.length;
    let itemActive = 0;


    next.onclick = function() {
        itemActive = itemActive + 1;
        if (itemActive >= countItem) {
            itemActive = 0;
        }
        showSlider();
    }

    prev.onclick = function() {
        itemActive = itemActive - 1;
        if (itemActive < 0) {
            itemActive = countItem - 1;
        }
        showSlider();
    }

    /*
    let refreshInterval = setInterval(() => {
      next.click();
    }, 3000);
    */

    function showSlider() {
        let itemActiveOld = document.querySelector('.slider .list .item.active');
        let thumbActiveOld = document.querySelector('.tn .item.active');

        itemActiveOld.classList.remove('active');
        thumbActiveOld.classList.remove('active');
        items[itemActive].classList.add('active');
        thumb[itemActive].classList.add('active');

        thumb[itemActive].style.filter = 'brightness(100%)';
        thumb[itemActive].style.transform = 'scale(1.25)';
        thumbActiveOld.style.filter = 'brightness(50%)';
        thumbActiveOld.style.transform = 'scale(1.0)';
        /*
        clearInterval(refreshInterval);
        refreshInterval = setInterval(() => {
          next.click();
        }, 3000);
        */
    }

    thumb.forEach((thumb, index) => {
        thumb.addEventListener('click', () => {
            itemActive = index;
            showSlider();
        });
    });

</script>

<style scoped>
    .slider {
       
    }
    
    .slider .list {
        width: 100%;
    }

    .slider .list .item {
        position: absolute;
        inset: 0 0 0 0;
        overflow: auto;
        opacity: 0;
        transition: 1s;
        width: 100%;
        max-width: 1600px;
        place-self: center;
        }

    .slider .list .item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .slider .list .item::after {
        content: "";
        width: 100%;
        height: 100%;
        position: absolute;
        left: 0;
        bottom: 0;
        background-image: linear-gradient(
            to top, #000 5%, transparent
        );
    }
    
    .slider .list .item .content-wrapper {
        display:flex;
        flex-direction: column;
        max-width: 1200px;
    }

    .slider .list .item .content-wrapper .content {
        position: absolute;
        left: 50px;
        top: 50px;
        width: 350px;
        z-index: 1;
    }

    .slider .list .item .content-wrapper .content div {
        text-transform: uppercase;
        letter-spacing: 10px;
        color: #DDD;
    }
    
    .slider .list .item .content-wrapper .content p {
        font-family: "Sora";
        font-size: 1rem;
        color: var(--color-nordsilver);
    }

    .slider .list .item .content-wrapper .content h4 {
        font-size: 3rem;
        line-height: 2.8rem;
        font-weight: 100;
        margin: 0 0 20px 0;
        color: var(--color-brightemerald);
    }

    .slider .list .item.active {
        opacity: 1;
        z-index: 10;
    }

    @keyframes showContent {
        to {
            transform: translateY(0);
            filter: blur(0);
            opacity: 1;
        }
    }

    .slider .list .item.active .content-wrapper .content p,
    .slider .list .item.active .content-wrapper .content h4,
    .slider .list .item.active .content-wrapper .content div {
        transform: translateY(30px);
        filter: blur(10px);
        opacity: 0;
        animation: showContent 0.5s 0.7s ease-in-out 1 forwards;
    }

   .slider .list .item.active .content-wrapper .content h4 { animation-delay: 1s;} 
   .slider .list .item.active .content-wrapper .content p { animation-duration: 1.3s; }

   .arrows {
       height: fit-content;
       width: 90%;
       display: flex;
       z-index: 30;
       border: 1 solid white;
       justify-content: space-between;
       position: absolute;
       bottom: 180px;
       left: 5%;
       padding: 0 5% 0 5%;
       
   }

   .arrows div.buttons {
        background-color: var(--color-nordsilver);
        border: none;
        font-family: "Material Symbols Outlined";
        font-size: 1.5rem;
        font-weight: 600;
        width: 30px;
        height: 30px;
        border-radius: 30px;
        color: var(--color-sherpasblue);
        cursor: pointer;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0;
        margin: 0;
        transition: 0.5s;
   }

   .arrow .buttons:hover {
    background-color: var(--color-brightemerald);
    color: var(--color-prune);
   }
   
   .arrow div#prev {
       
   }
   
   .arrow div#next {
       
   }

   .tn {
        position: absolute;
        bottom: 150px;
        left: 0;
        z-index: 11;
        display: flex;
        gap: 5px;
        width: 100%;
        min-width: 350px;
        height: 90px;
        
        
        overflow: visible;
        justify-content: center;
        align-items: center;
   }

   .tn::-webkit-scrollbar {
    width: 0;
   }

   .tn .item {
    width: 90px;
    height: 90px;
    transition: 0.5s;
    flex-shrink: 0;
    z-index: 11
   }
   
   .tn .item.active {
    transform: scale(1.25);
    z-index: 15;
   }

   .tn .item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
   }
   

   .tn .item .content {
    position: absolute;
    inset: auto 10px 10px 10px;
    color: var(--color-pastellime);
    opacity: 0;
   }

   @media screen and (max-width: 800px) {
    .tn .item  { width: 65px; height: 60px; }
    .slider .list .item .content-wrapper .content h2 { font-size: 2rem; }
    .slider .list .item .content-wrapper { display: flex; position: relative; flex-direction: column; justify-content: start; align-items: start; }
    .slider .list .item .content-wrapper .content { width: 80%; top: 0; display: flex; position: relative; flex-direction: column; justify-content: start; }
    .slider .list .item .content-wrapper .content div,
    .slider .list .item .content-wrapper .content h4,
    .slider .list .item .content-wrapper .content p { display: flex; position: relative;}
    .slider .list .item img { left: 50%; width:100%; transition: 0.5s; padding-bottom: 50px;}
    .arrows { width: fit-content; left: 40%; gap: 15px; top: 10px;  }
   }
   
   @media screen and (max-width: 350px) {
    .slider .list .item { display: flex; position: relative; flex-direction: column; justify-content: start; align-items: start; }
    .slider .list .item .content-wrapper .content { width: 100%; top: 0; display: flex; position: relative; flex-direction: column; justify-content: start; }
    .slider .list .item .content-wrapper .content div,
    .slider .list .item .content-wrapper .content h4,
    .slider .list .item .content-wrapper .content p { display: flex; position: relative;}
    .slider .list .item img { width: 50%; transition: 0.5s;}
    .arrows div.buttons { width: fit-content; left: 40%; gap: 15px; top: 10px;  }
   }

</style>
