<script>

    let items = document.querySelectorAll('.slider .list .item');
    let next = document.getElementById('next');
    let prev = document.getElementById('prev');
    let thumb = document.querySelectorAll('.tn .item');

    let countItem = items.length;
    let itemActive = 0;


    next.onclick = function() {
        itemActive = itemActive + 1;
        if (itemActive >= countItem) {
            itemActive = 0;
        }
        showSlider();
    }

    prev.onclick = function() {
        itemActive = itemActive - 1;
        if (itemActive < 0) {
            itemActive = countItem - 1;
        }
        showSlider();
    }

    /*
    let refreshInterval = setInterval(() => {
      next.click();
    }, 3000);
    */

    function showSlider() {
        let itemActiveOld = document.querySelector('.slider .list .item.active');
        let thumbActiveOld = document.querySelector('.tn .item.active');

        itemActiveOld.classList.remove('active');
        thumbActiveOld.classList.remove('active');
        items[itemActive].classList.add('active');
        thumb[itemActive].classList.add('active');

        thumb[itemActive].style.filter = 'brightness(100%)';
        thumb[itemActive].style.transform = 'scale(1.25)';
        thumbActiveOld.style.filter = 'brightness(80%)';
        thumbActiveOld.style.transform = 'scale(1.0)';
        /*
        clearInterval(refreshInterval);
        refreshInterval = setInterval(() => {
          next.click();
        }, 3000);
        */
    }

    thumb.forEach((thumb, index) => {
        thumb.addEventListener('click', () => {
            itemActive = index;
            showSlider();
        });
    });

</script>

<style scoped>
    .slider {
        height: 100%;
    }

    .slider .list {

    }

    .slider .list .item {
        position: absolute;
        inset: 0 0 0 0;
        opacity: 0;
        transition: 1s;
        width: 100%;
        top:0;
        overflow: hidden;
    }

    .slider .list .item img {
        width: 100%;
        height: 100%;
